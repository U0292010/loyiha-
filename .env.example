SECRET_KEY=django-insecure-local-development-only-change-before-deploy
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=uytop
POSTGRES_USER=uytop
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-a-generated-url-safe-password
# Optional override; Compose builds DATABASE_URL from the POSTGRES_* values when unset.
# DATABASE_URL=postgresql://uytop:replace-with-a-generated-url-safe-password@db:5432/uytop
DB_CONN_MAX_AGE=60
WEB_PORT=8000